# Copy to .env and fill in ONLY what you use. Never commit .env.
# Keys live server-side only — the frontend never sees them.

# fake (default, free, deterministic) | openai | ollama
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini

# For LLM_PROVIDER=openai (works with any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# For LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# CORS: frontend origins, comma-separated (tighten in production)
ALLOWED_ORIGINS=*

# Agent rails
MAX_AGENT_STEPS=8
AGENT_APPROX_TOKEN_BUDGET=40000
RATE_LIMIT_PER_MIN=30
